<script>
  // ─── Live uptime counter ───
  let baseDays = 847;
  let baseHours = 14;
  let baseMinutes = 22;
  let baseSeconds = 9;
  let totalSeconds = baseDays * 86400 + baseHours * 3600 + baseMinutes * 60 + baseSeconds;

  function formatUptime(s) {
    const days = Math.floor(s / 86400);
    const hrs = Math.floor((s % 86400) / 3600);
    const mins = Math.floor((s % 3600) / 60);
    const secs = s % 60;
    return `${String(days).padStart(3,'0')}:${String(hrs).padStart(2,'0')}:${String(mins).padStart(2,'0')}:${String(secs).padStart(2,'0')}`;
  }

  setInterval(() => {
    totalSeconds++;
    const el = document.getElementById('uptimeCounter');
    if (el) el.textContent = formatUptime(totalSeconds);
    const days = Math.floor(totalSeconds / 86400);
    const yl = document.getElementById('liveYears');
    if (yl) yl.textContent = days;
  }, 1000);

  // ─── Scroll reveal ───
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, i) => {
      if (entry.isIntersecting) {
        setTimeout(() => entry.target.classList.add('visible'), i * 80);
      }
    });
  }, { threshold: 0.1 });

  reveals.forEach(el => observer.observe(el));

  // ─── Nav scroll effect ───
  window.addEventListener('scroll', () => {
    const nav = document.querySelector('nav');
    if (window.scrollY > 60) nav.style.borderBottomColor = 'rgba(232,81,10,0.2)';
    else nav.style.borderBottomColor = 'var(--border)';
  });
</script>
</body>
</html>
